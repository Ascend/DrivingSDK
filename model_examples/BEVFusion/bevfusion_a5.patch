+#!/usr/bin/env bash
+
+CONFIG=$1
+GPUS=$2
+NNODES=$3
+NODE_RANK=$4
+PORT=$5
+MASTER_ADDR=$6
+
+PYTHONPATH="$(dirname $0)/..":$PYTHONPATH \
+python -m torch.distributed.launch \
+    --nnodes=$NNODES \
+    --node_rank=$NODE_RANK \
+    --master_addr=$MASTER_ADDR \
+    --nproc_per_node=$GPUS \
+    --master_port=$PORT \
+    $(dirname "$0")/train.py \
+    $CONFIG \
+    --launcher pytorch ${@:7}
